{
  "name": "@osl/cli",
  "version": "1.0.0-alpha.2",
  "description": "OSL command line: init, propose, apply, generate, migrate, verify, mcp",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./propose": {
      "types": "./dist/propose.d.ts",
      "default": "./dist/propose.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "postbuild": "chmod +x dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1",
    "@modelcontextprotocol/sdk": "^1",
    "@osl/backend-drizzle-next": "workspace:*",
    "@osl/backend-gin-pgx": "workspace:*",
    "@osl/backend-hono-trpc-vite": "workspace:*",
    "@osl/conformance": "workspace:*",
    "@osl/core": "workspace:*",
    "chalk": "^5",
    "commander": "^12",
    "yaml": "^2",
    "zod": "^3"
  },
  "bin": {
    "osl": "./dist/cli.js"
  }
}
