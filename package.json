{
  "name": "osl",
  "private": true,
  "description": "Open Schema Language: a compiler from a declared application model to working code.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "format": "prettier --write \"packages/**/*.{ts,js,json,md,yaml,yml}\" \"fixtures/**/*.{ts,js,json,md,yaml,yml}\" \"evals/**/*.{md,yaml,yml}\" \"*.{json,md,yaml,yml}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json,md,yaml,yml}\" \"fixtures/**/*.{ts,js,json,md,yaml,yml}\" \"evals/**/*.{md,yaml,yml}\" \"*.{json,md,yaml,yml}\"",
    "conformance": "tsx packages/conformance/src/run.ts",
    "evals": "tsx packages/evals/src/run.ts",
    "evals:generate": "tsx packages/evals/src/generate-cli.ts",
    "evals:gaps": "tsx packages/evals/src/gaps-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
