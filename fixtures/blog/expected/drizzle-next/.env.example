# Copy to .env and fill in. Keep your own variables outside the OSL region.
# osl:begin env
DATABASE_URL=postgres://postgres@localhost:5432/blog
OSL_SESSION_SECRET=change-me-to-a-long-random-string
# The key sealed fields are encrypted under (64 hexadecimal characters, 32 bytes: openssl rand -hex 32). Keep it: without it the stored values cannot be read
OSL_SEAL_KEY=
OSL_APP_URL=http://localhost:3000
# OSL_EMAIL=log|resend|capture (default: resend when RESEND_API_KEY is set, else log)
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@example.com
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# OSL_STORAGE=local|s3 (default: s3 when S3_BUCKET is set, else local)
OSL_STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT= (R2, MinIO, Supabase)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# OSL_ROLE=web|worker|all (default all)
# osl:end env
