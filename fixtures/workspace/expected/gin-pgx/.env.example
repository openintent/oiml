# Copy to .env and export it, or set the variables in the environment. Keep your own variables outside the OSL region.
# osl:begin env
DATABASE_URL=postgres://postgres@localhost:5432/workspace
# The web process connects as the role the tenant policies bind; osl migrate gives it the password you put here
DATABASE_APP_URL=postgres://workspace_app:CHOOSE-A-PASSWORD@localhost:5432/workspace
PORT=8080
OSL_SESSION_SECRET=change-me-to-a-long-random-string
OSL_APP_URL=http://localhost:8080
# OSL_EMAIL=log|resend|capture (resend when RESEND_API_KEY is set, else log)
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@example.com
# OSL_ROLE=web|worker|all (default all: this process also runs queued events)
# osl:end env
